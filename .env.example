# GLM Coding Plan Key（与智谱标准 API Key 可能不通用）
ZHIPU_API_KEY=替换为你的智谱_Coding_Plan_Key
ZHIPU_MODEL=glm-5.2
MULTI_AGENT_ENABLED=true
ZHIPU_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
# 模型网关策略与聊天上下文预算
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_INPUT_CHAR_BUDGET=60000
LLM_MAX_OUTPUT_TOKENS=2000
CHAT_CONTEXT_TOKEN_BUDGET=12000
CHAT_SUMMARY_TOKEN_BUDGET=2000

# Embedding-2 使用智谱标准 API；Key 可与 Coding Plan Key 不同
ZHIPU_EMBEDDING_API_KEY=替换为你的智谱标准_API_Key
ZHIPU_EMBEDDING_MODEL=embedding-2
ZHIPU_EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

QDRANT_URL=http://localhost:6333
# 稳定读别名；物理版本由导入任务按 QDRANT_COLLECTION 前缀自动创建
QDRANT_COLLECTION=interview_knowledge
QDRANT_COLLECTION_ALIAS=interview_knowledge_current
# 发布锁 TTL 应覆盖一次完整的上传、回归评估和别名切换
KNOWLEDGE_PUBLISH_LOCK_SECONDS=3600
CONVERSATION_DB_PATH=data/interview-agent.db
# 生产环境使用 PostgreSQL；为空时回退到上面的 SQLite 路径
DATABASE_URL=
AUTO_CREATE_SCHEMA=true
POSTGRES_DB=interview_agent
POSTGRES_USER=interview
POSTGRES_PASSWORD=请替换为强密码
# 生产环境建议设置；为空时不启用 Bearer API Key 防护
APP_API_KEY=
AUTH_REQUIRED=false
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_FINAL_K=4
# 先保持 0；完成评估后设置经过校准的 RRF 或重排分数阈值
RETRIEVAL_MIN_SCORE=0
# 基于当前正负样本的 Embedding-2 初始拒答阈值
DENSE_RELEVANCE_MIN_SCORE=0.4
# 无需下载模型的查询词覆盖率轻量重排
LEXICAL_RERANKER_ENABLED=false
LEXICAL_RETRIEVAL_WEIGHT=0.35
# 使用 GLM-5.2 对候选知识块做列表式重排（会增加延迟和模型调用）
LLM_RERANKER_ENABLED=false
# 下载本地 Cross-Encoder 成功后可启用；启用时会替代轻量重排
RERANKER_ENABLED=false
RERANKER_MODEL=Xenova/bge-reranker-base
# 先保持 0；完成正负样本评估后再填写
RERANKER_MIN_SCORE=0

# 公开网络搜索（默认关闭；启用后查询会发送到配置的第三方搜索服务）
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10

# 知识库导入完成后运行 chunk 级回归，并以 nDCG@10 作为门禁
INGEST_RUN_EVALUATION=false
RAG_REGRESSION_MIN_NDCG=0

# Redis 共享限流、RAG 缓存和后台任务队列
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_QUEUE_NAME=interview-agent:jobs

# 结构化日志与 OpenTelemetry
LOG_LEVEL=INFO
JSON_LOGS=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=interview-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# 可选 Docker/Kubernetes Secret 文件；设置后无需把密钥写入 .env
ZHIPU_API_KEY_FILE=
ZHIPU_EMBEDDING_API_KEY_FILE=
WEB_SEARCH_API_KEY_FILE=
APP_API_KEY_FILE=

# 前端产物目录(Vue 构建输出)。留空则自动探测 frontend/dist;
# 不存在时回退到旧的内嵌静态页 app/web/。开发时无需设置(用 Vite dev server)。
FRONTEND_DIST=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=请替换为强密码
