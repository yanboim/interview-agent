# GLM Coding Plan Key（与智谱标准 API Key 可能不通用）
ZHIPU_API_KEY=替换为你的智谱_Coding_Plan_Key
ZHIPU_MODEL=glm-5.2
MULTI_AGENT_ENABLED=true
ZHIPU_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
# 按用途覆盖模型；留空时继承 ZHIPU_MODEL
LLM_MODEL_KNOWLEDGE=
LLM_MODEL_INTERVIEWER=
LLM_MODEL_EVALUATOR=
LLM_MODEL_PLANNER=
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_SCHEMA_REPAIR=
# 回退默认关闭；仅允许同一供应商且已经通过对应评测的用途
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_EVALUATION_APPROVED=false
LLM_FALLBACK_MODEL=
LLM_FALLBACK_APPROVED_PURPOSES=
LLM_PRICE_VERSION=zhipu-2026-07
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
# Workflow V2 是多 Agent 开启时的唯一拓扑；回滚使用上一不可变镜像
AGENT_CHAT_MAX_MODEL_CALLS=5
AGENT_CHAT_MAX_TOTAL_TOKENS=16000
AGENT_CHAT_MAX_COST_USD=1.0
AGENT_WORKFLOW_V2_MAX_MODEL_CALLS_PER_ROUTE=5
AGENT_EVALUATION_MAX_MODEL_CALLS=2
AGENT_EVALUATION_MAX_TOTAL_TOKENS=8000
AGENT_EVALUATION_MAX_COST_USD=0.5
# 模型网关策略与聊天上下文预算
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# 收到响应头后、尚未产生任何流式 chunk 即失败时的额外重启次数；部分流禁止重放
LLM_ZERO_CHUNK_STREAM_RESTARTS=1
LLM_MAX_CONCURRENCY=8
LLM_INPUT_CHAR_BUDGET=60000
LLM_MAX_OUTPUT_TOKENS=2000
CHAT_CONTEXT_TOKEN_BUDGET=12000
CHAT_SUMMARY_TOKEN_BUDGET=2000

# Embedding-2 使用智谱标准 API；Key 可与 Coding Plan Key 不同
ZHIPU_EMBEDDING_API_KEY=替换为你的智谱标准_API_Key
ZHIPU_EMBEDDING_MODEL=embedding-2
ZHIPU_EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_CACHE_DIR=data/fastembed-cache

QDRANT_URL=http://localhost:6333
# 稳定读别名；物理版本由导入任务按 QDRANT_COLLECTION 前缀自动创建
QDRANT_COLLECTION=interview_knowledge
QDRANT_COLLECTION_ALIAS=interview_knowledge_current
# 发布锁 TTL 应覆盖一次完整的上传、回归评估和别名切换
KNOWLEDGE_PUBLISH_LOCK_SECONDS=3600
CONVERSATION_DB_PATH=data/interview-agent.db
# 生产环境使用 PostgreSQL；为空时回退到上面的 SQLite 路径
DATABASE_URL=
AUTO_CREATE_SCHEMA=true
POSTGRES_DB=interview_agent
POSTGRES_USER=interview
POSTGRES_PASSWORD=请替换为强密码
# 生产环境建议设置；为空时不启用 Bearer API Key 防护
APP_API_KEY=
AUTH_REQUIRED=false
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_FINAL_K=4
# 先保持 0；完成评估后设置经过校准的 RRF 或重排分数阈值
RETRIEVAL_MIN_SCORE=0
# 基于当前正负样本的 Embedding-2 初始拒答阈值
DENSE_RELEVANCE_MIN_SCORE=0.4
# 无需下载模型的查询词覆盖率轻量重排
LEXICAL_RERANKER_ENABLED=false
LEXICAL_RETRIEVAL_WEIGHT=0.35
# 使用 GLM-5.2 对候选知识块做列表式重排（会增加延迟和模型调用）
LLM_RERANKER_ENABLED=false
# 下载本地 Cross-Encoder 成功后可启用；启用时会替代轻量重排
RERANKER_ENABLED=false
RERANKER_MODEL=Xenova/bge-reranker-base
# 先保持 0；完成正负样本评估后再填写
RERANKER_MIN_SCORE=0

# 公开网络搜索（默认关闭；启用后查询会发送到配置的第三方搜索服务）
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10

# 知识库导入完成后运行 chunk 级回归，并以 nDCG@10 作为门禁
INGEST_RUN_EVALUATION=false
RAG_REGRESSION_MIN_NDCG=0

# Redis 共享限流、RAG 缓存和后台任务队列
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_QUEUE_NAME=interview-agent:jobs

# 简历中心默认关闭；启用前确保 App 与 Worker 共享 USER_FILES_DIR
RESUME_FEATURE_ENABLED=false
USER_FILES_DIR=data/user-files
RESUME_MAX_UPLOAD_BYTES=10485760
RESUME_PROMPT_VERSION=resume-analysis-v1
# 简历评估是后台长任务，独立于聊天超时；队列已经提供有界重试。
RESUME_ANALYSIS_TIMEOUT_SECONDS=180
RESUME_ANALYSIS_MAX_RETRIES=0

# 真实面试文本复盘与音频转写均默认关闭。音频仅在以下转写配置完整时开放。
REVIEW_FEATURE_ENABLED=false
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_KEY_FILE=
TRANSCRIPTION_PROVIDER_NAME=configured-provider
TRANSCRIPTION_TIMEOUT_SECONDS=120
REVIEW_MAX_AUDIO_BYTES=26214400
REVIEW_PROMPT_VERSION=interview-review-v1
# 文本复盘是后台长任务；长面试按批次生成，队列负责有界重试。
REVIEW_ANALYSIS_BATCH_SIZE=6
REVIEW_ANALYSIS_TIMEOUT_SECONDS=180
REVIEW_ANALYSIS_MAX_RETRIES=0

# 结构化日志与 OpenTelemetry
LOG_LEVEL=INFO
JSON_LOGS=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=interview-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# 可选 Docker/Kubernetes Secret 文件；设置后无需把密钥写入 .env
ZHIPU_API_KEY_FILE=
ZHIPU_EMBEDDING_API_KEY_FILE=
WEB_SEARCH_API_KEY_FILE=
APP_API_KEY_FILE=

# 前端产物目录(Vue 构建输出)。留空则自动探测 frontend/dist;
# 不存在时回退到旧的内嵌静态页 app/web/。开发时无需设置(用 Vite dev server)。
FRONTEND_DIST=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=请替换为强密码

# Nginx 统一入口；生产公网访问仅开放此端口
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_HTTP_PORT=80
# App 仅绑定回环地址且 Compose 网络可信时允许代理传递真实客户端 IP
FORWARDED_ALLOW_IPS=*

# 系统资源中心探针超时；控制台链接必须是无凭据的 HTTP(S) 地址
RESOURCE_PROBE_TIMEOUT_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=20
ADMIN_PROMETHEUS_URL=
ADMIN_GRAFANA_URL=
